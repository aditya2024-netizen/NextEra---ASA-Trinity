# ==============================================================================
# CareTrack AI — Environment Variables Reference
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# in your Vercel Project Settings (Project Settings -> Environment Variables).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Recommended for Production)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection string (compatible with Supabase, Neon, AWS RDS, Railway, Render)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# If omitted or unreachable, CareTrack AI automatically falls back to an
# internal in-memory clinical dataset (1,000 synthetic patient records + seed accounts).
DATABASE_URL=""

# Optional maximum connection pool size for serverless execution (defaults to 5)
PG_MAX_CONNECTIONS="5"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Recommended for Production)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT authentication tokens.
# Generate a strong 32+ character string in production.
# Defaults to a demo secret if not provided.
JWT_SECRET="caretrack-super-secret-jwt-key-2024"

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI AI (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key used by the Clinical Operations Natural Language Assistant.
# If omitted, the assistant provides deterministic clinical operational guidance.
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. TWILIO SMS / WHATSAPP / CALLS (Optional)
# ------------------------------------------------------------------------------
# Credentials for live SMS notifications to patients.
# If omitted, CareTrack AI automatically operates in "Twilio Demo Mode",
# simulating multi-channel clinical outreach with complete audit logs.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# 5. APPLICATION SETTINGS (Local / Custom Environments)
# ------------------------------------------------------------------------------
# Standalone HTTP server port (used when running `npm start` or Docker; Vercel sets this automatically)
PORT="3000"

# Node environment
NODE_ENV="production"

# Frontend API Base URL (defaults to relative '/api', which works seamlessly on Vercel)
# Only set this if your frontend is hosted on a separate origin from the API.
VITE_API_BASE_URL=""
